# MEDI TASK — 환경 변수 이름 목록 (실제 값은 여기에 쓰지 않는다)
# 배포: Vercel 프로젝트 Settings → Environment Variables 에 등록
# 로컬 테스트: 터미널에서만 임시로 설정 (예: PowerShell  $env:GEMINI_API_KEY = "..." )

# Google AI Studio에서 발급한 Gemini API 키 (필수)
GEMINI_API_KEY=

# 기본 모델 (선택, 비우면 gemini-3.5-flash-lite). 화면에서 모델을 고르지 않았을 때 쓴다.
GEMINI_MODEL=

# 허용 모델 목록 (선택, 쉼표 구분). 설정하면 이 모델만 선택·호출할 수 있다. 고비용 모델 차단용.
# 예: gemini-3.5-flash-lite,gemini-2.5-flash-lite
GEMINI_ALLOWED_MODELS=
